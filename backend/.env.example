# Nastavení backendu evobeds. Zkopírujte jako .env a doplňte hodnoty.
# Soubor .env se NIKDY neukládá do gitu, obsahuje tajné klíče.

# ---------- Základ ----------
PORT=3400
# Veřejná adresa backendu (na ni brána vrací zákazníka po platbě)
BACKEND_URL=https://objednavky.evobeds.cz
# Adresa webu, kam se zákazník vrací s výsledkem platby
FRONTEND_URL=https://jtomoszek.github.io/evobeds
# Povolené domény webu pro CORS, oddělené čárkou
FRONTEND_PUVODY=https://jtomoszek.github.io,https://evobeds.cz,https://www.evobeds.cz
# Token pro ruční doslání objednávky do Pohody (zvolte dlouhý náhodný řetězec)
ADMIN_TOKEN=

# ---------- GP webpay ----------
# Testovací prostředí: https://test.3dsecure.gpwebpay.com/pgw/order.do
# Produkce:            https://3dsecure.gpwebpay.com/pgw/order.do
GPW_BRANA_URL=https://test.3dsecure.gpwebpay.com/pgw/order.do
# Číslo obchodníka (merchant number) přidělené bankou
GPW_CISLO_OBCHODNIKA=
# Privátní klíč obchodníka (PEM) vygenerovaný v portálu GP webpay
GPW_PRIVATNI_KLIC=./keys/gpwebpay-privatni.pem
# Heslo k privátnímu klíči
GPW_HESLO_KLICE=
# Veřejný podpisový certifikát brány (gpe.signing_prod.pem, ke stažení v portálu)
GPW_VEREJNY_CERT=./keys/gpe.signing_prod.pem

# ---------- Pohoda mServer ----------
# Adresa mServeru z pohledu VPS (doporučeně přes VPN nebo SSH tunel)
POHODA_MSERVER_URL=http://127.0.0.1:4444
POHODA_UZIVATEL=
POHODA_HESLO=
POHODA_ICO=07754523
# Sazba DPH položek: high = 21 %, low = 12 % (potvrďte s účetní,
# zdravotnické prostředky mohou spadat do snížené sazby)
POHODA_SAZBA_DPH=high

# ---------- E-maily ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_UZIVATEL=
SMTP_HESLO=
SMTP_ODESILATEL=info@evobeds.cz
EMAIL_OBCHOD=info@invira.cz
